{
    "manifest_version": 3,
    "name": "smartFill",
    "version": "1.0.0",
    "description": "Autofills tedious government exam forms instantly.",
    "permissions": [
        "activeTab",
        "scripting",
        "storage"
    ],
    "action": {
        "default_popup": "popup.html"
    },
    "options_ui": {
        "page": "options.html",
        "open_in_tab": true
    }
}